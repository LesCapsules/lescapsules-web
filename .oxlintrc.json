{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "unicorn",
    "oxc",
    "react",
    "jsx-a11y",
    "import",
    "nextjs"
  ],
  "categories": {
    "correctness": "error"
  },
  "env": {
    "browser": true,
    "node": true
  },
  "ignorePatterns": [
    "node_modules",
    "public",
    "out",
    ".cache",
    ".next",
    ".vscode",
    "next-env.d.ts",
    "package-lock.json",
    "next-env.d.ts"
  ]
}
